{
  "name": "pointlesh",
  "version": "0.1.0",
  "private": true,
  "description": "Composable point-and-click adventure tooling for TypeScript games.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build --workspace pointlesh-forest-demo",
    "build:site": "node site/build.mjs",
    "test:site": "node --test site/test.mjs",
    "build:packages": "tsc -b packages/core packages/designer packages/dev packages/phaser",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build:packages && node --test packages/*/test/*.test.mjs demos/forest/test/*.test.mjs",
    "dev": "npm run build:packages && node dev.mjs",
    "dev:server": "npm run build:packages && npm run dev:server --workspace pointlesh-forest-demo",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@ai-game-assets/dev": "^0.11.37",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "@scene-designer/core": {
      "@ai-game-assets/core": "^0.11.37"
    },
    "@scene-designer/designer": {
      "@ai-game-assets/core": "^0.11.37"
    },
    "@scene-designer/phaser": {
      "@ai-game-assets/core": "^0.11.37",
      "@ai-game-assets/phaser": "^0.11.37"
    },
    "@dialog-designer/core": {
      "@ai-game-assets/core": "^0.11.37"
    },
    "@dialog-designer/designer": {
      "@ai-game-assets/core": "^0.11.37"
    },
    "@dialog-designer/dev": {
      "@ai-game-assets/core": "^0.11.37",
      "@ai-game-assets/dev": "^0.11.37"
    },
    "@dialog-designer/phaser": {
      "@ai-game-assets/core": "^0.11.37",
      "@ai-game-assets/phaser": "^0.11.37"
    }
  }
}
