  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pointlesh/core": "0.1.0",
    "@scene-designer/dev": "^0.2.1",
    "@dialog-designer/dev": "^0.1.1",
