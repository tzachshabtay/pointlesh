{
  "name": "@pointlesh/dev",
  "version": "0.1.0",
  "description": "Local authoring persistence and tooling for Pointlesh adventures.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
